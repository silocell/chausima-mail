#!/usr/bin/env python3
"""Set the HWL Admin code (only you know it), or clear a lock after wrong codes.
   sudo hwl-admin-pin          set or change the code (asked twice, never shown)
   sudo hwl-admin-pin --unlock clear the 30-minute lock after wrong codes
   sudo hwl-admin-pin --status show whether a code is set and whether entry is locked
   sudo hwl-admin-pin --recovery  set the passphrase for the emergency recovery page (/hwl-admin/recover)
   sudo hwl-admin-pin --runner    make a new secret address for the emergency command page (old one stops working)
   sudo hwl-admin-pin --runner-show   show the secret address again
   sudo hwl-admin-pin --runner-off    switch the emergency command page off
   sudo hwl-admin-pin --admins        list who can use HWL Admin (everyone still needs the admin code)
   sudo hwl-admin-pin --add-admin name@example.com   /   --remove-admin name@example.com
Only a scrambled scrypt hash is kept, in /etc/hwl-admin/pin (root only). Changing it signs every admin out."""
import base64, getpass, hashlib, json, os, subprocess, sys, time
PIN, GUARD = "/etc/hwl-admin/pin", "/var/lib/hwl-admin/pin-guard.json"
REC, REC_GUARD = "/etc/hwl-admin/recover", "/var/lib/hwl-admin/recover-guard.json"
RUNNER, EM_GUARD = "/etc/hwl-admin/runner-path", "/var/lib/hwl-emergency/guard.json"
URL = "https://hehs-live.duckdns.org/hwl-emergency/"
if os.geteuid() != 0:
    sys.exit("Run it with sudo: sudo hwl-admin-pin")
arg = (sys.argv[1:] or [""])[0]
if arg == "--unlock":
    os.makedirs(os.path.dirname(GUARD), exist_ok=True)
    json.dump({"fails": [], "locked_until": 0}, open(GUARD, "w")); json.dump({}, open(REC_GUARD, "w"))
    os.makedirs(os.path.dirname(EM_GUARD), exist_ok=True); json.dump({"wrong": 0, "locked_until": 0}, open(EM_GUARD, "w"))
    sys.exit("Admin code entry, the recovery page and the emergency command page are unlocked.")
ADM = "/etc/hwl-admin/admins"
if arg in ("--admins", "--add-admin", "--remove-admin"):
    import re
    try: cur = [l.strip().lower() for l in open(ADM) if "@" in l and not l.strip().startswith("#")]
    except FileNotFoundError: cur = ["shivkforindia@gmail.com"]
    if arg != "--admins":
        who = (sys.argv[2:] or [""])[0].strip().lower()
        if not re.fullmatch(r"[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}", who):
            sys.exit("Give an email address, like: sudo hwl-admin-pin " + arg + " name@example.com")
        if arg == "--add-admin" and who not in cur: cur.append(who)
        if arg == "--remove-admin":
            if who not in cur: sys.exit(who + " isn't an admin.")
            if len(cur) == 1: sys.exit("That's the last admin, so it stays. Add another one first.")
            cur.remove(who)
        os.makedirs(os.path.dirname(ADM), exist_ok=True)
        fd = os.open(ADM + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.write(fd, ("# HWL Admin admins, one per line. Every admin still needs the admin code.\n" + "\n".join(cur) + "\n").encode()); os.close(fd)
        os.replace(ADM + ".tmp", ADM)
    sys.exit("HWL Admin admins (each needs the admin code too):\n  " + "\n  ".join(cur))
if arg in ("--runner", "--runner-show", "--runner-off"):
    import secrets, string
    if arg == "--runner-off":
        try: os.remove(RUNNER)
        except FileNotFoundError: pass
        sys.exit("Emergency command page switched off. Turn it back on with: sudo hwl-admin-pin --runner")
    if arg == "--runner" or not os.path.exists(RUNNER):
        p = "".join(secrets.choice(string.ascii_letters + string.digits) for _ in range(24))
        os.makedirs(os.path.dirname(RUNNER), exist_ok=True)
        fd = os.open(RUNNER + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600); os.write(fd, (p + "\n").encode()); os.close(fd)
        os.replace(RUNNER + ".tmp", RUNNER)
    print("Emergency command page (keep this address private, don't screenshot it):")
    sys.exit(URL + open(RUNNER).read().strip())
if arg == "--status":
    try: g = json.load(open(GUARD))
    except Exception: g = {}
    left = float(g.get("locked_until") or 0) - time.time()
    print("code set:", "yes" if os.path.exists(PIN) else "no", "| recovery passphrase set:", "yes" if os.path.exists(REC) else "no")
    try: r = json.load(open(REC_GUARD))
    except Exception: r = {}
    print("recovery page:", "locked until unlocked here" if r.get("hard") else "locked for a bit" if float(r.get("locked_until") or 0) > time.time() else "open")
    sys.exit("entry: locked for %d more minutes" % (left // 60 + 1) if left > 0 else "entry: open")
def ask(prompt):
    """Shows what you type, then wipes that line off the screen when you press Enter."""
    if not sys.stdin.isatty():
        return getpass.getpass(prompt)
    v = input(prompt)
    sys.stdout.write("\033[1A\033[2K\r" + prompt + "(hidden)\n"); sys.stdout.flush()
    return v
rec = arg == "--recovery"
target, need = (REC, 12) if rec else (PIN, 6)
a = ask(("New recovery passphrase (at least 12 characters, different from your admin code and passwords): " if rec else "New HWL Admin code (at least 6 characters, nothing you use anywhere else): "))
if len(a) < need or len(a) > 128:
    sys.exit("It needs to be at least %d characters. Nothing changed." % need)
if a.isdigit() and len(set(a)) <= 2 or a in ("123456", "654321", "1234567", "12345678", "000000", "password"):
    sys.exit("That code is too easy to guess. Nothing changed.")
if ask("Type it again: ") != a:
    sys.exit("They didn't match. Nothing changed.")
salt = os.urandom(16)
h = hashlib.scrypt(a.encode(), salt=salt, n=2 ** 14, r=8, p=1, dklen=32)
os.makedirs(os.path.dirname(target), exist_ok=True); os.chmod(os.path.dirname(target), 0o700)
fd = os.open(target + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, ("scrypt$%s$%s\n" % (base64.b64encode(salt).decode(), base64.b64encode(h).decode())).encode()); os.close(fd)
os.replace(target + ".tmp", target)
if rec:
    sys.exit("Recovery passphrase saved. The page is at https://hehs-live.duckdns.org/hwl-admin/recover")
subprocess.run(["systemctl", "restart", "hwl-admin"])
print("Admin code saved. HWL Admin restarted, so every admin has to enter the new code.")
